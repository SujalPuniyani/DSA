class Solution:
    def nthRoot(self, n, m):
       # code here
        if n == 1 or m == 0:
           return m
        low, high = 1, m
        while low <= high:
            mid = (low + high) // 2
            if mid ** n == m:
               return mid
            elif mid ** n < m:
                low = mid + 1
            else:
                high = mid - 1
        
        return -1
        
