class Solution:
    def findFloor(self, arr, x):
        # code here
        n = len(arr)
        index = -1
        low, high = 0, n - 1
        while low <= high:
            mid = (low + high) // 2
            if arr[mid] <= x:
                index = mid
                low = mid + 1
            else:
                high = mid - 1
            
        
        return index
        
