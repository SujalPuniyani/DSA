class Solution:
    def maximumSaleItems(self, items, budget):
        mx = max(f for f, _ in items)
        cnt = [0] * (mx + 1)
        for f, _ in items:
            cnt[f] += 1

        # total[f] = number of items whose factor is a multiple of f
        total = [0] * (mx + 1)
        for f in range(1, mx + 1):
            if cnt[f] == 0:
                continue
            s = 0
            for x in range(f, mx + 1, f):
                s += cnt[x]
            total[f] = s

        m = min(p for _, p in items)

        # (price, d_i) for items that can give free copies
        units = []
        for f, p in items:
            d = total[f] - 1  # exclude itself
            if d > 0 and p < 2 * m:
                units.append((p, d))
        units.sort()

        rem = budget
        ans = 0
        for p, d in units:
            k = min(d, rem // p)
            ans += 2 * k
            rem -= k * p
            if k < d:
                break

        ans += rem // m
        return ans
