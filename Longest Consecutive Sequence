class Solution:
    def longestConsecutive(self, nums: list[int]) -> int:
        my_set = set()
        for i in nums:
            my_set.add(i)

        longest = 0

        for i in my_set:
            if i - 1 not in my_set:
                x = i        
                count = 1
                while x + 1 in my_set:
                    count += 1
                    x += 1
                longest = max(longest, count)
        
        return longest
                
